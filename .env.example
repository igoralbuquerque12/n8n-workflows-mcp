# Base URL of your n8n instance, without /api/v1
N8N_URL=https://n8n.example.com
# Your personal key from n8n -> Settings -> n8n API (never commit it)
N8N_API_KEY=your-api-key-here
# read = no writes, confirm = every write needs confirmProduction=true, write = writes allowed (default)
N8N_ACCESS=write
# Optional comma-separated words; a workflow whose name contains one of them (whole word, any case) is protected
N8N_PROTECTED_NAMES=production,prod
# false = protected workflows need confirmProduction=true to change; true = protected workflows are hidden and cannot be read or changed at all
N8N_BLOCK_PROTECTED=false
# Optional absolute folder where the previous JSON is saved before update, patch and delete
N8N_BACKUP_DIR=/absolute/path/to/n8n-workflows-mcp/n8n-backups

# Optional: Used to access the Vibe Git for version control
VIBE_GIT_AI_API_KEY=
GITHUB_TOKEN=
